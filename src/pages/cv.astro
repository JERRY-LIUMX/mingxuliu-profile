---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="CV — Mingxu Liu" description="Resume and CV downloads for Mingxu Liu.">
  <div class="narrow-wrap">
    <div style="padding: 56px 0 80px;">
      <div class="section-label">Documents</div>
      <h1 class="section-title">CV & Resumes</h1>
      <p style="color:var(--muted);font-size:0.95rem;margin-bottom:36px;max-width:560px;line-height:1.65;">
        Download the resume or CV below. A full academic CV will be added here when available.
      </p>

      <div class="cv-grid">
        <div class="cv-card">
          <div class="cv-card-title">Resume</div>
          <div class="cv-card-desc">
            Research and engineering experience in medical robotics, computer vision, medical imaging, AR/XR, and real-time systems.
          </div>
          <a href={profile.resumes[0].href} target="_blank" rel="noopener">Download PDF →</a>
        </div>

        <div class="cv-card">
          <div class="cv-card-title">Full Academic CV</div>
          <div class="cv-card-desc">
            A complete academic CV including all publications, projects, education, experience, and service.
          </div>
          <div class="cv-placeholder">Coming soon</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
