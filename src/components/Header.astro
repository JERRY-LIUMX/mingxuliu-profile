---
import { profile } from '../data/profile';
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="inner">
    <a href={`${base}/`} class="brand">{profile.name}</a>
    <nav class="site-nav">
      <a href={`${base}/`} class={pathname === `${base}/` || pathname === base ? 'active' : ''}>Home</a>
      <a href={`${base}/projects`} class={pathname.startsWith(`${base}/projects`) ? 'active' : ''}>Projects</a>
      <a href={`${base}/experience`} class={pathname === `${base}/experience` ? 'active' : ''}>Experience</a>
      <a href={`${base}/publications`} class={pathname === `${base}/publications` ? 'active' : ''}>Publications</a>
      <a href={`${base}/docs/resume.pdf`} target="_blank" rel="noopener" download>Resume</a>
    </nav>
  </div>
</header>
